{
  "name": "@71zone/vite-plugin-obfuscate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite plugin that obfuscates bundles with javascript-obfuscator and a custom identifier vocabulary.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "default": "./dist/vocabulary.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "javascript-obfuscator": "^5.9.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
