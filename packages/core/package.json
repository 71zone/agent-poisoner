{
  "name": "@71z/agent-poisoner-core",
  "version": "0.1.0",
  "description": "Build-tool agnostic obfuscation core: adversarial vocabulary, camelCase names, comment injection, and uglification.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "javascript-obfuscator": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
