{
  "name": "@71z/vite-agent-poisoner",
  "version": "0.1.0",
  "description": "Vite plugin for LLM agent evasion: adversarial vocabulary, uglification, and comment injection.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@71z/agent-poisoner-core": "workspace:*",
    "@71z/agent-poisoner-vocabulary": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
