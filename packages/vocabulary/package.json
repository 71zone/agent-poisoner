{
  "name": "@7one/agent-poisoner-vocabulary",
  "version": "0.1.3",
  "description": "Default adversarial vocabulary for agent-poisoner: words, compound sequences, and sentences.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/71zone/agent-poisoner.git",
    "directory": "packages/vocabulary"
  },
  "homepage": "https://github.com/71zone/agent-poisoner/tree/main/packages/vocabulary#readme",
  "bugs": {
    "url": "https://github.com/71zone/agent-poisoner/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "vocabulary.yaml",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
